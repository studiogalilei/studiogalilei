# Resend API key used by /api/invia-email to send the contact and Member Club form emails.
# Required: without it the endpoint answers 500 "Configurazione email mancante".
RESEND_API_KEY=

# Optional sender address (default: "Sito Studio Galilei <sito@members.studiogalilei.com>").
# The sending domain must be verified in Resend.
RESEND_FROM=
